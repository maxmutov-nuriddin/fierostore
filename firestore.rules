rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        (
          request.auth.token.admin == true ||
          request.auth.token.email in [
            "admin@fierostore.com"
          ]
        );
    }

    function hasValidProductPayload() {
      return request.resource.data.keys().hasOnly([
          "title",
          "slug",
          "price",
          "images",
          "sizes",
          "colors",
          "description",
          "category",
          "featured",
          "isNewDrop",
          "rating",
          "createdAt"
        ]) &&
        request.resource.data.title is string &&
        request.resource.data.slug is string &&
        request.resource.data.price is number &&
        request.resource.data.images is list &&
        request.resource.data.sizes is list &&
        request.resource.data.colors is list &&
        request.resource.data.description is string &&
        request.resource.data.category is string;
    }

    function hasValidOrderPayload() {
      return request.resource.data.keys().hasOnly([
          "customerName",
          "phone",
          "address",
          "items",
          "totalPrice",
          "createdAt"
        ]) &&
        request.resource.data.customerName is string &&
        request.resource.data.phone is string &&
        request.resource.data.address is string &&
        request.resource.data.items is list &&
        request.resource.data.totalPrice is number;
    }

    function hasValidReviewPayload() {
      return request.resource.data.keys().hasOnly([
          "productId",
          "rating",
          "comment",
          "author",
          "createdAt"
        ]) &&
        request.resource.data.productId is string &&
        request.resource.data.rating is number &&
        request.resource.data.rating >= 1 &&
        request.resource.data.rating <= 5 &&
        request.resource.data.comment is string &&
        request.resource.data.author is string;
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() && hasValidProductPayload();
    }

    match /orders/{orderId} {
      allow create: if hasValidOrderPayload();
      allow read, update, delete: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if hasValidReviewPayload();
      allow update, delete: if isAdmin();
    }
  }
}
